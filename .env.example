# 1. Primary Google Gemini API Keys (Optional custom keys or env rotation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

VITE_GEMINI_KEY_1=your_gemini_key_1
VITE_GEMINI_KEY_2=your_gemini_key_2
# ... (through KEY_68)

# 2. Secondary Engine: Cloudflare Workers AI
VITE_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
VITE_CLOUDFLARE_AI_TOKEN=your_cloudflare_ai_token
VITE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
